#!/usr/bin/env bash
#
# audio-out -- pick the audio output (or input), and actually move everything
#              to it.
#
#   audio-out            dmenu picker for outputs (bind a key to this)
#   audio-out menu       same
#   audio-out -i         dmenu picker for inputs (microphones)
#   audio-out move       move every running stream onto the current default
#   audio-out list       print the outputs, marking the current default
#   audio-out status     one line: what the default output is
#
# PulseAudio now picks sensibly on its own -- module-switch-on-connect is
# blacklisted away from the dock and the laptop's HDMI ports in
# /etc/pulse/default.pa, so docking no longer steals the default, while
# Bluetooth still grabs it on connect. This is for the times you want to
# override that.
#
# The difference from pavucontrol: setting the default sink only decides where
# *new* streams go. This also moves the streams that are already playing, so
# one keystroke actually changes what comes out of the speakers. Inputs get the
# same treatment (`-i`), which is what you want after the dock has been sitting
# there as a phantom default microphone.

set -u
export DISPLAY="${DISPLAY:-:0}"

BAR="${HOME}/shell_scripts/statusbar"

# Same palette as `display`, so the pickers look like one tool.
DMENU=(dmenu -i -fn "monospace:size=16"
       -nb "#222222" -nf "#bbbbbb" -sb "#ac8a8c" -sf "#eeeeee")
DMENU_LIST=("${DMENU[@]}" -l 16)

# Backgrounded and time-limited for the same reason `display` does it: at login
# this can run before dunst does, and notify-send will otherwise block waiting
# on a notification service that has not started yet.
notify() {
    command -v notify-send >/dev/null || return 0
    ( timeout 5 notify-send -t 3000 "$1" "$2" >/dev/null 2>&1 & ) 2>/dev/null
    return 0
}

# ------------------------------------------------------------------ pulse info

# "name<TAB>description", one device per line. Name comes before Description in
# `pactl list` output. Monitor sources are dropped -- they are loopbacks of the
# outputs, never something you want to pick as a microphone.
devices() {
    case "$1" in
        sink)   pactl list sinks 2>/dev/null ;;
        source) pactl list sources 2>/dev/null ;;
    esac | awk '
        /^[ \t]*Name:/        { name = $2 }
        /^[ \t]*Description:/ {
            if (name ~ /\.monitor$/) next
            sub(/^[ \t]*Description: /, "")
            print name "\t" $0
        }'
}

current() {
    case "$1" in
        sink)   pactl info 2>/dev/null | awk -F': ' '/^Default Sink:/{print $2}'   ;;
        source) pactl info 2>/dev/null | awk -F': ' '/^Default Source:/{print $2}' ;;
    esac
}

describe() {
    devices "$1" | awk -F'\t' -v n="$2" '$1==n {print $2; exit}'
}

# ------------------------------------------------------------------- switching

# Move every running stream. Some streams refuse to move (pavucontrol's own
# peak-level probes, mostly); that is not worth reporting, so stderr goes away.
move_all() {
    local kind=$1 target=$2 i
    case "$kind" in
        sink)
            pactl list short sink-inputs 2>/dev/null | cut -f1 | while read -r i; do
                [ -n "$i" ] && pactl move-sink-input "$i" "$target" 2>/dev/null
            done
            ;;
        source)
            pactl list short source-outputs 2>/dev/null | cut -f1 | while read -r i; do
                [ -n "$i" ] && pactl move-source-output "$i" "$target" 2>/dev/null
            done
            ;;
    esac
    return 0
}

switch_to() {
    local kind=$1 name=$2 desc
    desc=$(describe "$kind" "$name")
    case "$kind" in
        sink)   pactl set-default-sink   "$name" || return 1 ;;
        source) pactl set-default-source "$name" || return 1 ;;
    esac
    move_all "$kind" "$name"
    notify "audio ${kind/sink/output}" "${desc:-$name}"
    [ -x "$BAR" ] && "$BAR" refresh >/dev/null 2>&1
    return 0
}

pick() {
    local kind=$1 def entries choice name
    def=$(current "$kind")
    entries=$(devices "$kind" | while IFS=$'\t' read -r name desc; do
        if [ "$name" = "$def" ]; then printf '* %s\n' "$desc"
        else                          printf '  %s\n' "$desc"
        fi
    done)
    [ -n "$entries" ] || { notify "audio" "no devices"; return 1; }

    choice=$(printf '%s\n' "$entries" | \
        "${DMENU_LIST[@]}" -p "audio ${kind/sink/output}:") || return 0
    [ -n "$choice" ] || return 0
    choice=${choice:2}   # strip the "* " / "  " current-device marker

    name=$(devices "$kind" | awk -F'\t' -v d="$choice" '$2==d {print $1; exit}')
    [ -n "$name" ] || { notify "audio" "no such device"; return 1; }
    switch_to "$kind" "$name"
}

# ----------------------------------------------------------------------- main

case "${1:-menu}" in
    menu|"")
        pick sink
        ;;
    -i|input|in)
        pick source
        ;;
    move)
        # Yank everything onto whatever the default already is.
        move_all sink   "$(current sink)"
        move_all source "$(current source)"
        notify "audio output" "$(describe sink "$(current sink)")"
        ;;
    list)
        def=$(current sink)
        devices sink | while IFS=$'\t' read -r name desc; do
            if [ "$name" = "$def" ]; then printf '* %s\n' "$desc"
            else                          printf '  %s\n' "$desc"
            fi
        done
        ;;
    status)
        echo "out: $(describe sink "$(current sink)")"
        echo "in:  $(describe source "$(current source)")"
        ;;
    *)
        echo "usage: ${0##*/} [menu|-i|move|list|status]" >&2
        exit 2
        ;;
esac
